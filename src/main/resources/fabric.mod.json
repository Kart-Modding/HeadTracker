{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Replaces the colored dots on the locator bar with the tracked players' heads.",
  "authors": [
    "Kartonekk"
  ],
  "contact": {
    "homepage": "https://github.com/Kart-Modding/HeadTracker",
    "sources": "https://github.com/Kart-Modding/HeadTracker",
    "issues": "https://github.com/Kart-Modding/HeadTracker/issues"
  },
  "license": "MIT",
  "icon": "assets/headtracker/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.karton.headtracker.HeadTrackerFabric"
    ],
    "modmenu": [
      "dev.karton.headtracker.HeadTrackerModMenuApi"
    ]
  },
  "mixins": [
    "headtracker.mixins.json"
  ],
  "accessWidener": "headtracker.ct",
  "depends": {
    "fabricloader": ">=0.17",
    "minecraft": "${minecraft}"
  },
  "suggests": {
    "modmenu": "*",
    "xaerominimap": "*"
  }
}